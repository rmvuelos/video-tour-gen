# Copy to .env.local (never commit real values). Read by docker compose and pydantic-settings.
SUPABASE_URL=http://host.docker.internal:55421
SUPABASE_JWKS_URL=http://host.docker.internal:55421/auth/v1/.well-known/jwks.json
# Public Supabase URL + /auth/v1 (the token's iss claim), not the Docker-internal URL.
SUPABASE_JWT_ISSUER=http://127.0.0.1:55421/auth/v1
SUPABASE_SECRET_KEY=your-secret-key
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://postgres:your-password@host.docker.internal:55422/postgres
